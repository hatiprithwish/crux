{
  "name": "crux-worker",
  "main": "src/index.ts",
  // DEV_NOTE: keep it up to date with the current date.
  "compatibility_date": "2026-05-22",
  // DEV_NOTE: nodejs_compat flag is needed for using AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_CORS_ORIGIN": "http://localhost:3000",
    // DEV_NOTE: "local" is the only value that enables the checkAuth bypass in AuthMiddleware.ts — must be an exact match, staging/production below override this.
    "APP_ENV": "local",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crux-db",
      "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
      "migrations_dir": "src/db/migrations",
      "remote": true,
    },
  ],
  "env": {
    "staging": {
      "name": "crux-worker-staging",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "http://localhost:3000,https://crux-web-staging.hatiprithwish.workers.dev",
        "APP_ENV": "staging",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crux-db",
          "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
          "migrations_dir": "src/db/migrations",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "crux-worker",
      "vars": {
        "ALLOWED_CORS_ORIGIN": "https://crux-web.hatiprithwish.workers.dev",
        "APP_ENV": "production",
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crux-db",
          "database_id": "8c4994d0-094e-42ef-a1bf-5d2cc24c8b82",
          "migrations_dir": "src/db/migrations",
          "remote": true,
        },
      ],
      // DEV_NOTE: architecture.md §4.1 point 3 — weekly orphan scan, Sunday 00:00 UTC. Production
      // only: staging has no real user data for a referential-integrity check to be meaningful.
      "triggers": {
        "crons": ["0 0 * * 0"],
      },
    },
  },
}
