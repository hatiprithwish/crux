{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crux-web",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // DEV_NOTE: no "vars" here on purpose. The client reads VITE_* through `import.meta.env`, which
  // Vite inlines at BUILD time from .env locally and from the GitHub environment secrets in CI —
  // a Worker runtime var of the same name is never read. Change the API URL in .env / the
  // VITE_API_URL environment secret, not here.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "staging": {
      "name": "crux-web-staging",
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "production": {
      "name": "crux-web",
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
