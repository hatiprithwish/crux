meta {
  name: Create category entity
  type: http
  seq: 2
}

post {
  url: {{host}}/entities
  body: json
  auth: none
}

body:json {
  {
    "entity": {
      "name": "Bruno Travel",
      "kind": "tag"
    }
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  bru.setVar("categoryPublicId", res.body.entity.publicId);
}
