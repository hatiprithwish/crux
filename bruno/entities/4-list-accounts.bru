meta {
  name: List accounts
  type: http
  seq: 4
}

get {
  url: {{host}}/entities?kind=account
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("the created account is in the list", function() {
    const ids = res.body.entities.map((entity) => entity.publicId);
    expect(ids).to.include(bru.getVar("accountPublicId"));
  });
}
