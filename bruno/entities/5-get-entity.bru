meta {
  name: Get one entity
  type: http
  seq: 5
}

get {
  url: {{host}}/entities/{{accountPublicId}}
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("kind and name round-trip", function() {
    expect(res.body.entity.kind).to.equal("account");
    expect(res.body.entity.name).to.equal("Bruno Cash");
  });
}
