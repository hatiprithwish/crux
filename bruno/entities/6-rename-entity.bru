meta {
  name: Rename an entity
  type: http
  seq: 6
}

patch {
  url: {{host}}/entities/{{accountPublicId}}
  body: json
  auth: none
}

body:json {
  {
    "entity": {
      "name": "Bruno Cash (renamed)",
      "emoji": "💳"
    }
  }
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("the new name and emoji come back", function() {
    expect(res.body.entity.name).to.equal("Bruno Cash (renamed)");
    expect(res.body.entity.emoji).to.equal("💳");
  });
}
