meta {
  name: List notes
  type: http
  seq: 2
}

get {
  url: {{host}}/notes
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("includes the note created in this run", function() {
    const publicIds = res.body.notes.map((n) => n.publicId);
    expect(publicIds).to.include(bru.getVar("notePublicId"));
  });
}
