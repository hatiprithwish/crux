meta {
  name: Update note
  type: http
  seq: 4
}

patch {
  url: {{host}}/notes/{{notePublicId}}
  body: json
  auth: none
}

body:json {
  {
    "note": {
      "title": "Bruno Test Note (updated)"
    }
  }
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("title is updated", function() {
    expect(res.body.note.title).to.equal("Bruno Test Note (updated)");
  });

  test("publicId is unchanged", function() {
    expect(res.body.note.publicId).to.equal(bru.getVar("notePublicId"));
  });
}
