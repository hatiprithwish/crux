meta {
  name: Create the entity everything rolls up to
  type: http
  seq: 1
}

post {
  url: {{host}}/entities
  body: json
  auth: none
}

body:json {
  {
    "entity": {
      "name": "Bruno Fitness",
      "kind": "project"
    }
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  bru.setVar("rollupEntityPublicId", res.body.entity.publicId);
}
