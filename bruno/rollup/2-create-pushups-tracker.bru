meta {
  name: Create the Pushups tracker
  type: http
  seq: 2
}

post {
  url: {{host}}/trackers
  body: json
  auth: none
}

body:json {
  {
    "tracker": {
      "name": "Bruno Pushups",
      "activeFrom": "2026-04-01",
      "manifest": {
        "control": "increment",
        "metrics": [],
        "target": null,
        "step": 10,
        "entryMode": "retro",
        "schedule": { "type": "daily" },
        "compute": null
      }
    },
    "metric": {
      "mode": "new",
      "metric": {
        "key": "bruno_rollup_pushups",
        "name": "Pushups",
        "semanticType": "count",
        "canonicalUnit": "count",
        "defaultAgg": "sum",
        "direction": "higher_better",
        "dateAttribution": "start"
      }
    }
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  bru.setVar("pushupsTrackerPublicId", res.body.tracker.publicId);
}
