meta {
  name: List after archive
  type: http
  seq: 13
}

get {
  url: {{host}}/trackers
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("the archived tracker is gone from the list", function() {
    const ids = res.body.trackers.map((tracker) => tracker.publicId);
    expect(ids).to.not.include(bru.getVar("trackerPublicId"));
  });
}
