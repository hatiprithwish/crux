meta {
  name: Log the same day again (idempotent)
  type: http
  seq: 4
}

post {
  url: {{host}}/trackers/{{trackerPublicId}}/entries
  body: json
  auth: none
}

body:json {
  {
    "payload": {
      "control": "toggle",
      "date": "2026-03-01",
      "completed": true
    }
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });

  test("no duplicate entry — the day still holds exactly one", function() {
    expect(res.body.todayCount).to.equal(1);
  });
}
