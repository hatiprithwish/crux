meta {
  name: Create a tracker to archive
  type: http
  seq: 1
}

post {
  url: {{host}}/trackers
  body: json
  auth: none
}

body:json {
  {
    "tracker": {
      "name": "Bruno Restore Me",
      "activeFrom": "2026-04-01",
      "manifest": {
        "control": "toggle",
        "metrics": [],
        "target": null,
        "step": null,
        "entryMode": "retro",
        "schedule": { "type": "daily" },
        "compute": null
      }
    },
    "metric": {
      "mode": "new",
      "metric": {
        "name": "Bruno Restore Me",
        "semanticType": "boolean",
        "canonicalUnit": "boolean",
        "defaultAgg": "sum",
        "direction": "higher_better",
        "dateAttribution": "start"
      }
    }
  }
}

tests {
  test("returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  bru.setVar("restoreTrackerPublicId", res.body.tracker.publicId);
}
