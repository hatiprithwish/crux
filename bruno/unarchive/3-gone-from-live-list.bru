meta {
  name: It leaves the live list
  type: http
  seq: 3
}

get {
  url: {{host}}/trackers
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("the archived tracker is not in the default list", function() {
    const ids = res.body.trackers.map((tracker) => tracker.publicId);
    expect(ids).to.not.include(bru.getVar("restoreTrackerPublicId"));
  });
}
