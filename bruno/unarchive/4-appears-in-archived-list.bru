meta {
  name: It appears in the archived list
  type: http
  seq: 4
}

get {
  url: {{host}}/trackers?archived=true
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("the archived tracker is there", function() {
    const ids = res.body.trackers.map((tracker) => tracker.publicId);
    expect(ids).to.include(bru.getVar("restoreTrackerPublicId"));
  });
}
