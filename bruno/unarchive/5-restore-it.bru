meta {
  name: Restore it
  type: http
  seq: 5
}

post {
  url: {{host}}/trackers/{{restoreTrackerPublicId}}/unarchive
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("both archival columns are cleared — archived_at and active_to", function() {
    expect(res.body.tracker.archivedAt).to.equal(null);
    expect(res.body.tracker.activeTo).to.equal(null);
  });
}
